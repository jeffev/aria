generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL configurada em prisma.config.ts (Prisma 7+)
}

// ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null para usuários OAuth-only
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  tasks         Task[]
  events        Event[]
  notes         Note[]
  aiMessages    AiMessage[]
  settings      Setting[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domínio ─────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id             String      @id @default(cuid())
  userId         String
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime?
  allDay         Boolean     @default(false)
  recurrence     Recurrence  @default(NONE)
  recurrenceEnd  DateTime?
  source         EventSource @default(MANUAL)
  sourceId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Notification {
  id         String             @id @default(cuid())
  source     NotificationSource
  sourceId   String
  content    String
  read       Boolean            @default(false)
  receivedAt DateTime           @default(now())

  @@unique([source, sourceId])
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventSource {
  MANUAL
  TEAMS
  GOOGLE_CALENDAR
}

enum NotificationSource {
  TEAMS
  DISCORD
}
