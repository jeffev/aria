# ============================================================
# LOCAL (Docker)
# ============================================================
# DATABASE_URL="postgresql://aria:aria_dev@localhost:5432/aria_db"
# DIRECT_URL="postgresql://aria:aria_dev@localhost:5432/aria_db"

# ============================================================
# CLOUD (Supabase)
# Supabase usa porta 6543 (pooler) para queries e 5432 para migrations
# ============================================================
# DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============================================================
# IA — Google Gemini
# https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Microsoft Teams (Microsoft Graph API)
# Requer aprovação do admin de TI para conta corporativa
# https://portal.azure.com → App registrations
# ============================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REFRESH_TOKEN=

# ============================================================
# Discord
# https://discord.com/developers/applications
# ============================================================
DISCORD_TOKEN=
DISCORD_USER_ID=

# ============================================================
# Cron (apenas cloud — Vercel valida este header)
# Gere com: openssl rand -base64 32
# ============================================================
CRON_SECRET=

# ============================================================
# Google Calendar
# https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Scope necessário: https://www.googleapis.com/auth/calendar.readonly
# Após criar, acesse /api/google/auth para autorizar
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Autenticação (NextAuth v5)
# Gere o AUTH_SECRET com: openssl rand -base64 32
# ============================================================
AUTH_SECRET=

# Google OAuth para login (pode ser o mesmo app do Calendar ou um separado)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# API Key para o overlay desktop (Electron)
# Gere com: openssl rand -base64 32
# O overlay envia: Authorization: Bearer <ARIA_API_KEY>
ARIA_API_KEY=
